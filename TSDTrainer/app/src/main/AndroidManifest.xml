<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:name=".TSDTrainerApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TSDTrainer.ActionBar"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.TSDTrainer.ActionBar"
            tools:ignore="LockedOrientationActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MovementPracticeActivity"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.TSDTrainer.ActionBar"
            tools:ignore="LockedOrientationActivity" />

        <!-- FIX: was com.tsdtrainer.data.LinePracticeActivity — class is package com.tsdtrainer.app -->
        <activity
            android:name=".LinePracticeActivity"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.TSDTrainer.ActionBar"
            tools:ignore="LockedOrientationActivity" />

        <!-- FIX: was com.tsdtrainer.data.KnowledgePracticeActivity — class is package com.tsdtrainer.app -->
        <activity
            android:name=".KnowledgePracticeActivity"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.TSDTrainer.ActionBar"
            tools:ignore="LockedOrientationActivity" />

        <!-- NEW: Knowledge Quiz -->
        <activity
            android:name=".KnowledgeQuizActivity"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.TSDTrainer.ActionBar"
            tools:ignore="LockedOrientationActivity" />

        <!-- KoreanTermsActivity is genuinely in package com.tsdtrainer.data -->
        <activity
            android:name="com.tsdtrainer.data.KoreanTermsActivity"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.TSDTrainer.ActionBar"
            tools:ignore="LockedOrientationActivity" />

        <activity
            android:name=".HistoryActivity"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.TSDTrainer.ActionBar"
            tools:ignore="LockedOrientationActivity" />

        <!-- Essay Requirements -->
        <activity
            android:name=".EssayRequirementsActivity"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.TSDTrainer.ActionBar"
            tools:ignore="LockedOrientationActivity" />

        <activity
            android:name=".SettingsActivity"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.TSDTrainer.ActionBar"
            tools:ignore="LockedOrientationActivity" />

    </application>

</manifest>