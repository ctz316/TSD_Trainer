<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:orientation="vertical">

    <!-- Main Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Belt Display Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/beltFrame"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="30dp"
                app:cardBackgroundColor="#663300"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🥋"
                        android:textSize="60sp" />

                    <TextView
                        android:id="@+id/tvBeltName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="White Belt"
                        android:textColor="@color/white"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvMotivation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:text="Don't be afraid to fail. Be afraid not to try."
                        android:textColor="@color/white"
                        android:textSize="16sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Knowledge Practice Button -->
            <Button
                android:id="@+id/btnKnowledgePractice"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:layout_marginBottom="12dp"
                android:backgroundTint="#1A1A1A"
                android:text="📖 Knowledge Practice"
                android:textColor="@color/white"
                android:textSize="18sp" />

            <!-- Knowledge Quiz Button -->
            <Button
                android:id="@+id/btnKnowledgeQuiz"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:layout_marginBottom="12dp"
                android:backgroundTint="#1A1A1A"
                android:text="❓ Knowledge Quiz"
                android:textColor="@color/white"
                android:textSize="18sp" />

            <!-- Korean Terms Button -->
            <Button
                android:id="@+id/btnKoreanTerms"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:layout_marginBottom="12dp"
                android:backgroundTint="#1A1A1A"
                android:text="🇰🇷 Korean Terms"
                android:textColor="@color/white"
                android:textSize="18sp" />

            <!-- Movement Practice Button -->
            <Button
                android:id="@+id/btnMovementPractice"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:layout_marginBottom="12dp"
                android:backgroundTint="#1A1A1A"
                android:text="🥋 Movement Practice"
                android:textColor="@color/white"
                android:textSize="18sp" />

            <!-- Line Practice Button -->
            <Button
                android:id="@+id/btnLinePractice"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:layout_marginBottom="12dp"
                android:backgroundTint="#1A1A1A"
                android:text="🎯 Line Practice"
                android:textColor="@color/white"
                android:textSize="18sp" />

            <!-- Essay Requirements Button -->
            <Button
                android:id="@+id/btnEssayRequirements"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:layout_marginBottom="12dp"
                android:backgroundTint="#1A1A1A"
                android:text="📝 Essay Requirements"
                android:textColor="@color/white"
                android:textSize="18sp" />

            <!-- History Button -->
            <Button
                android:id="@+id/btnHistory"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:layout_marginBottom="12dp"
                android:backgroundTint="#1A1A1A"
                android:text="📊 History"
                android:textColor="@color/white"
                android:textSize="18sp" />

            <!-- Version Label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Version 4.1"
                android:textColor="#808080"
                android:textSize="12sp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>