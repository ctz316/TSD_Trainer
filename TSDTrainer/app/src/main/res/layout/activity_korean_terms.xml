<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Score Bar (blue theme) -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:cardBackgroundColor="#1A1A1A"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp"
        app:strokeColor="#1E90FF"
        app:strokeWidth="1dp">

        <TextView
            android:id="@+id/tvKoreanScore"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="10dp"
            android:text="Score: 0 / 0  |  Streak: 0"
            android:textColor="#1E90FF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Question Card (blue theme) -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.4"
        android:layout_marginBottom="12dp"
        app:cardBackgroundColor="#1A1A1A"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeColor="#1E90FF"
        app:strokeWidth="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WHAT IS THE KOREAN TERM?"
                android:textColor="#1E90FF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                android:layout_marginBottom="8dp" />

            <!-- Category chip -->
            <TextView
                android:id="@+id/tvKoreanCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#1E90FF"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:text="Category"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/tvKoreanQuestion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Loading..."
                android:textColor="@color/white"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Answer Cards (2x2 grid — blue theme) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:orientation="vertical">

        <!-- Row 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardKoreanAnswer1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="#1A1A1A"
                app:cardCornerRadius="10dp"
                app:cardElevation="2dp"
                app:strokeColor="#444444"
                app:strokeWidth="1dp">

                <TextView
                    android:id="@+id/tvKoreanAnswer1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:padding="12dp"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:maxLines="4"
                    android:ellipsize="end"
                    android:clickable="false"
                    android:focusable="false"
                    android:text="A" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardKoreanAnswer2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="#1A1A1A"
                app:cardCornerRadius="10dp"
                app:cardElevation="2dp"
                app:strokeColor="#444444"
                app:strokeWidth="1dp">

                <TextView
                    android:id="@+id/tvKoreanAnswer2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:padding="12dp"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:maxLines="4"
                    android:ellipsize="end"
                    android:clickable="false"
                    android:focusable="false"
                    android:text="B" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Row 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardKoreanAnswer3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="#1A1A1A"
                app:cardCornerRadius="10dp"
                app:cardElevation="2dp"
                app:strokeColor="#444444"
                app:strokeWidth="1dp">

                <TextView
                    android:id="@+id/tvKoreanAnswer3"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:padding="12dp"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:maxLines="4"
                    android:ellipsize="end"
                    android:clickable="false"
                    android:focusable="false"
                    android:text="C" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardKoreanAnswer4"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="#1A1A1A"
                app:cardCornerRadius="10dp"
                app:cardElevation="2dp"
                app:strokeColor="#444444"
                app:strokeWidth="1dp">

                <TextView
                    android:id="@+id/tvKoreanAnswer4"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:padding="12dp"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:maxLines="4"
                    android:ellipsize="end"
                    android:clickable="false"
                    android:focusable="false"
                    android:text="D" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </LinearLayout>

    <!-- Feedback -->
    <TextView
        android:id="@+id/tvKoreanFeedback"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="12dp"
        android:textSize="20sp"
        android:textStyle="bold"
        android:text=""
        android:visibility="gone" />

    <!-- Next Question Button (blue) -->
    <Button
        android:id="@+id/btnKoreanNext"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="4dp"
        android:backgroundTint="#1E90FF"
        android:text="Next Term ➡️"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:visibility="gone" />

</LinearLayout>
